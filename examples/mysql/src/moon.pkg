import {
  "Hosi121/sql_session" @sql,
  "Hosi121/sql_conformance" @contract,
  "Hosi121/mysql",
  "moonbitlang/async",
  "moonbitlang/core/env",
  "moonbitlang/core/string",
}

supported_targets = "native"

pkgtype(kind: "executable")

options(
  link: { "native": { "cc-link-flags": "-lmariadb -lpthread" } },
)
